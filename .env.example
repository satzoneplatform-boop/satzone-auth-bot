# =============================================================================
# SAT Zone — Telegram bot environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All variables are read by app/config.py (pydantic-settings).
# =============================================================================

# ---- Telegram ----
# Bot token issued by @BotFather. Treat as a secret.
BOT_TOKEN=
# Bot username WITHOUT the leading @ (used in user-facing copy / deep links).
BOT_USERNAME=

# ---- Backend API ----
# Base URL of the SAT Zone API the bot calls to link contacts.
# Replace the placeholder with the real API URL before deploying.
API_BASE_URL=http://api:8000
# Shared API key authenticating bot ↔ API calls in BOTH directions.
# Sent as the `X-Internal-Secret` header. MUST match the API's
# TELEGRAM_INTERNAL_SECRET. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
INTERNAL_SECRET=

# ---- Internal OTP-push server (the API POSTs codes here) ----
# 0.0.0.0 is safe ONLY when the service is behind a private network / k8s
# ClusterIP — never expose this port publicly.
INTERNAL_HOST=0.0.0.0
INTERNAL_PORT=8081

# ---- Operational tuning (optional; safe defaults shown) ----
# Python log level for application loggers (DEBUG / INFO / WARNING / ERROR).
LOG_LEVEL=INFO
# Per-call timeout for outgoing HTTP requests (seconds).
HTTP_TIMEOUT_SECONDS=10
# How long a deep-link `state` is remembered per chat before it expires (seconds).
LINK_STATE_TTL_SECONDS=900
# Per-chat OTP delivery rate limit (max sends per minute).
OTP_RATE_LIMIT_PER_MIN=10
# Per-chat throttle for user-initiated OTP requests (contact shares):
# max CONTACT_RATE_LIMIT_MAX shares per CONTACT_RATE_LIMIT_WINDOW_SECONDS.
# Defaults: 3 shares per 5 minutes per chat.
CONTACT_RATE_LIMIT_MAX=3
CONTACT_RATE_LIMIT_WINDOW_SECONDS=300
